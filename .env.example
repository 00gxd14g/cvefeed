# ---------------------------------------------------------------- database
# These three are all the database needs. Compose builds the containers' DSN
# from them (the user and database name in the URL, the password through
# PGPASSWORD, so it needs no escaping) and points it at the `postgres` service.
# The command-line tool reads this same file and builds its own DSN aimed at
# localhost, where `make up` publishes the database on the loopback address —
# so `cvefeed scan` on this machine needs nothing more than a copied .env.
#
# Do not add a CVEFEED_DATABASE_URL here. An earlier example shipped one, and
# because an explicit DSN wins over POSTGRES_*, changing the password on line
# two silently left the tool authenticating with the old one. Set it in the
# environment only when the database is somewhere other than this stack.
#
# compose reads `$` as the start of an interpolation; a password containing
# one has to be written as `$$`.
POSTGRES_USER=cvefeed
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cvefeed
# The host port `make up` publishes the database on (loopback only).
POSTGRES_PORT=5432

# -------------------------------------------------------------------- api
CVEFEED_PORT=8080
CVEFEED_LISTEN_ADDR=:8080
# When set, every /v1 endpoint requires "Authorization: Bearer <token>".
CVEFEED_API_TOKEN=
CVEFEED_LOG_LEVEL=info

# ------------------------------------------------------------- credentials
# Optional but strongly recommended: raises the NVD limit from 5 to 50
# requests per 30 seconds. Request one at https://nvd.nist.gov/developers/request-an-api-key
CVEFEED_NVD_API_KEY=
# Raises the GitHub API limit from 60 to 5000 requests/hour. The CVE List
# baseline, Vulnrichment and the GitHub Advisory Database are all fetched from
# api.github.com, so without a token those collectors will be throttled.
CVEFEED_GITHUB_TOKEN=
CVEFEED_VULNCHECK_TOKEN=

# --------------------------------------------------------------- scheduler
CVEFEED_SCHEDULE_ENABLED=true

# Opens POST /v1/scan/target, which makes this service connect to hosts a caller
# names. It reaches whatever this container reaches — including hosts on your
# network that the caller cannot reach themselves — so it is off unless you turn
# it on. `cvefeed scan -target` needs nothing enabled; this is only the endpoint.
CVEFEED_TARGET_SCAN_ENABLED=false
# Per-source cadence overrides, as Go durations (30m, 2h, 24h). Empty means the
# default. All eleven are passed through to the api container by the compose
# file; a name not listed there would reach only the host-side tool.
# Defaults: cvelist 1h, kev 1h, vulnrichment 1h, nvd 2h, fkie 6h, euvd 6h,
#           osv 6h, ghsa 6h, csaf 12h, epss 24h, gcve 24h
CVEFEED_INTERVAL_CVELIST=
CVEFEED_INTERVAL_NVD=
CVEFEED_INTERVAL_FKIE=
CVEFEED_INTERVAL_VULNRICHMENT=
CVEFEED_INTERVAL_OSV=
CVEFEED_INTERVAL_GHSA=
CVEFEED_INTERVAL_EUVD=
CVEFEED_INTERVAL_GCVE=
CVEFEED_INTERVAL_CSAF=
CVEFEED_INTERVAL_KEV=
CVEFEED_INTERVAL_EPSS=

# -------------------------------------------------------------------- csaf
# Comma separated vendor base URLs or full provider-metadata.json URLs.
# A base URL is probed at /.well-known/csaf/provider-metadata.json; a value that
# already ends in .json is used as-is, which is what several vendors need —
# Red Hat's metadata is at security.access.redhat.com/data/csaf/v2/, and its
# .well-known path is a 404. Both ROLIE feeds and directory distributions
# (changes.csv / index.txt) are walked.
# This is the OT/ICS path — populate it with the vendors in your estate.
# CSAF vendor advisories. Comma separated provider-metadata.json URLs, or the
# base URL of a provider. Without any, the csaf collector reports that it has
# none and does nothing — which is why it shows zero records on a fresh install.
#
# These three answered 200 when this line was written. Endpoints move: Red Hat's
# .well-known location redirects, and several published lists still point at
# paths that now 404, so check before adding one.
CVEFEED_CSAF_PROVIDERS=https://security.access.redhat.com/data/csaf/v2/provider-metadata.json,https://advisories.ncsc.nl/.well-known/csaf/provider-metadata.json,https://advisories.stackable.tech/.well-known/csaf/provider-metadata.json

# ----------------------------------------------------------------- air gap
# Reading a bundle: collectors never touch the network. Inside the compose
# stack the Makefile's air-gap targets keep the bundle at
# /var/lib/cvefeed/bundle/data, which is the value to use for the api service.
# A bundle and a recording cannot both be set: `ingest` refuses the pair
# rather than quietly recording nothing.
CVEFEED_BUNDLE_PATH=
# Refuse to fall back to the network if no bundle is configured.
CVEFEED_OFFLINE_ONLY=false
# Writing a bundle while ingesting online (harvester side).
CVEFEED_RECORD_PATH=

# ------------------------------------------------------------------- tuning
# Deadline for response headers, not for the whole transfer: the bulk artefacts
# run to 1.4 GiB and an end-to-end deadline would abort every backfill.
CVEFEED_HTTP_TIMEOUT=120s
CVEFEED_HTTP_MAX_RETRIES=5
# Records buffered between the collectors and the database writers.
CVEFEED_INGEST_BATCH_SIZE=500
# Set this. Several upstreams filter on the User-Agent and at least one rejects
# a request that carries no mailto contact; the built-in default is obvious
# placeholder text so an unset value is visible in an upstream's request log.
CVEFEED_USER_AGENT=cvefeed/1.0 (+https://your.org/cvefeed; mailto=security@your.org)
CVEFEED_VULNLOOKUP_URL=https://vulnerability.circl.lu
# Set to any value to turn off the interactive progress display that `ingest`
# and `scan` draw on a terminal; useful for cron jobs and CI logs.
#CVEFEED_NO_PROGRESS=1
